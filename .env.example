# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the app, no trailing slash. Used in emails and payment links.
APP_URL=http://localhost:3000

# Postgres (Neon or Supabase). Use the pooled connection string on Vercel.
DATABASE_URL=postgres://postgres@localhost:5432/aipe

# Comma-separated team emails. Only these can open /admin. They also get new-application alerts.
ADMIN_EMAILS=hitesh@example.com,sujay@example.com,ruthwik@example.com

# Email (Resend). Without RESEND_API_KEY, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="AIPE Labs <hello@yourdomain.com>"

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bunny Stream video (Stream → Library → API / Security). Token auth must be ON in the library.
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# Private Slack invite link, sent in the welcome email after payment.
SLACK_INVITE_URL=
